# OpenRouter API key for the multimeter vision model.
OPENROUTER_API_KEY=
# OpenRouter API base URL.
DEBUG_DEVICES_OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
# Seconds for one vision model request.
DEBUG_DEVICES_VISION_TIMEOUT=90
# Make and model of the multimeter, for example "PROSTER T21D". The vision prompt names it. Empty: not named.
DEBUG_DEVICES_METER_MODEL=
# Bench plausibility limits: a meter value above them is disputed (a misread, for example a wrong decimal point).
DEBUG_DEVICES_MAX_VOLTAGE=30
DEBUG_DEVICES_MAX_CURRENT=10
# The diode test voltage of the meter: a diode-mode reading above it is uncertain (the dial is probably on DC V).
DEBUG_DEVICES_MAX_DIODE_VOLTAGE=3
# Display counts of the meter for volts and amperes (6000 for the Proster T21D: 4 digits, at most 5999).
# 0: unknown, no display check.
DEBUG_DEVICES_METER_COUNTS=0
# Seconds between the frames of one multimeter_read (it reads 2 frames by default).
DEBUG_DEVICES_METER_FRAME_INTERVAL=1
# Local 7-segment decoder of the meter LCD. off: no local code runs. compare: multimeter_read and bench_measure also
# add local_reading and local_agrees (the vision result stays the measurement). The local dataset keeps only the LCD
# area, and only when a webcam crop is set.
# Calibrate first: debug-devices-sevenseg calibrate --image <webcam crop>.
DEBUG_DEVICES_METER_LOCAL_DECODER=off
# OpenRouter model id. It must accept image input.
DEBUG_DEVICES_VISION_MODEL=openai/gpt-6-luna
# V4L2 device of the webcam that points at the multimeter.
DEBUG_DEVICES_WEBCAM=/dev/video0
# Crop x,y,w,h in pixels of the webcam frame. Only this part leaves the PC (tools and OpenRouter). Empty: no crop.
DEBUG_DEVICES_WEBCAM_CROP=
# Webcam frames to drop after the start (auto exposure settles), the ffmpeg path, and the seconds for one frame.
DEBUG_DEVICES_WEBCAM_WARMUP_FRAMES=10
DEBUG_DEVICES_FFMPEG_PATH=ffmpeg
DEBUG_DEVICES_WEBCAM_TIMEOUT=20
# v4l2-ctl for the meter webcam image controls (webcam_controls). Default: v4l2-ctl on PATH (dev shell).
DEBUG_DEVICES_V4L2_CTL_PATH=v4l2-ctl
# ADB serial of the phone. Empty: the user selects the phone in the monitor page (Devices). The server never picks a
# device by itself, also not the only one (it can be a TV).
DEBUG_DEVICES_ADB_SERIAL=
# avahi-browse: the fallback (after python-zeroconf) that finds wireless-debugging phones for the Devices list.
DEBUG_DEVICES_AVAHI_BROWSE_PATH=avahi-browse
# The adb binary, and the seconds for one adb command.
DEBUG_DEVICES_ADB_PATH=adb
DEBUG_DEVICES_ADB_TIMEOUT=15
# The local port of `adb forward tcp:<port> tcp:8765` to the camera app.
DEBUG_DEVICES_LOCAL_FORWARD_PORT=18765
# Seconds: one phone API request, one still capture (/v1/snapshot), and the app start after `am start`.
DEBUG_DEVICES_PHONE_HTTP_TIMEOUT=10
DEBUG_DEVICES_PHONE_SNAPSHOT_TIMEOUT=30
DEBUG_DEVICES_APP_START_TIMEOUT=20
# Seconds between the health checks while the camera app starts.
DEBUG_DEVICES_POLL_INTERVAL=0.5
# Your bench instructions for the agents (Markdown). Default: instructions.md at the repo root. See instructions.example.md.
DEBUG_DEVICES_INSTRUCTIONS=
# The local bench record (JSON, git-ignored): power state, confirmed measurements, steps. Default: bench-state.json at the repo root.
DEBUG_DEVICES_BENCH_STATE_FILE=
# Monitor window (local web page on 127.0.0.1). false turns off the page, the shared webcam stream, and scrcpy start.
DEBUG_DEVICES_UI=true
# When the page and the webcam stream start. lazy: at the first tool call and the first webcam use (nothing at process start). eager: at process start.
DEBUG_DEVICES_UI_START=lazy
# Lazy mode: seconds without frame users and page viewers before the webcam stream stops and frees the camera. 0 keeps it on.
DEBUG_DEVICES_WEBCAM_IDLE_TIMEOUT=300
# Port of the monitor page. The server takes a free port when this one is busy.
DEBUG_DEVICES_UI_PORT=18766
# Open the monitor page in a new Firefox window at each MCP start.
DEBUG_DEVICES_UI_OPEN_BROWSER=true
# Exact origins (a comma list) that can also use the monitor page, for example an https tunnel to it: https://bench.example.org.
# Empty (the default): only 127.0.0.1 and localhost. The tunnel must have its own login: the page has no login, and it controls the phone and the camera.
DEBUG_DEVICES_UI_ALLOWED_ORIGINS=
# Show the phone screen in the monitor page after phone_connect (the scrcpy server), and the long edge of its video.
DEBUG_DEVICES_PHONE_SCREEN=true
DEBUG_DEVICES_PHONE_SCREEN_MAX_SIZE=1280
# Also open a separate scrcpy window after phone_connect.
DEBUG_DEVICES_SCRCPY_WINDOW=false
# The scrcpy server that goes to the phone for the page screen, and its version (empty: from `scrcpy --version`; it
# must match the server).
DEBUG_DEVICES_SCRCPY_SERVER_PATH=/usr/share/scrcpy/scrcpy-server
DEBUG_DEVICES_SCRCPY_SERVER_VERSION=
# Path of the scrcpy binary.
DEBUG_DEVICES_SCRCPY_PATH=scrcpy
# Path of the obv-dump binary (boardview parser). Default: obv-dump on PATH (from the dev shell).
BOARDVIEW_DUMP_BIN=obv-dump
# Seconds for one obv-dump run.
DEBUG_DEVICES_BOARDVIEW_DUMP_TIMEOUT=60
# Decryption keys for encrypted boardview formats. You supply them. Never commit them.
BOARDVIEW_FZ_KEY=
BOARDVIEW_CAE_KEY=
BOARDVIEW_XZZ_KEY=
# Local board file for the local-only boardview tests. Tests skip when it is empty.
BOARDVIEW_TARGET=
# Schematic PDF for schematic_find. It stays local: the server never sends it to a web service. Empty: no schematic.
DEBUG_DEVICES_SCHEMATIC=
# Paths of the poppler tools for schematic_find (from the dev shell), and their timeout in seconds.
DEBUG_DEVICES_PDFTOTEXT_PATH=pdftotext
DEBUG_DEVICES_PDFTOPPM_PATH=pdftoppm
DEBUG_DEVICES_SCHEMATIC_TIMEOUT=60
# Development: 1 makes scripts/mcp-server.sh run the reload proxy (debug-devices-mcp-dev). The script reads it from
# its own environment (for example the env of the MCP client config), not from this file.
# DEBUG_DEVICES_DEV_RELOAD=1
