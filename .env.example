# OpenRouter API key for the multimeter vision model.
OPENROUTER_API_KEY=
# OpenRouter model id. It must accept image input.
DEBUG_DEVICES_VISION_MODEL=openai/gpt-6-luna
# V4L2 device of the webcam that points at the multimeter.
DEBUG_DEVICES_WEBCAM=/dev/video0
# ADB serial of the phone. Empty means the only connected device.
DEBUG_DEVICES_ADB_SERIAL=
