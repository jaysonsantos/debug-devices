$HEADER
GENCAD 1.4
USER "debug-devices test fixture"
DRAWING "obv-dump rotation and side test"
REVISION "1"
UNITS THOU
ORIGIN 0 0
INTERTRACK 0
$ENDHEADER
$BOARD
LINE 0 0 1000 0
LINE 1000 0 1000 500
LINE 1000 500 0 500
LINE 0 500 0 0
$ENDBOARD
$PADS
PAD p_smd RECTANGULAR 0
RECTANGLE -10 -10 20 20
$ENDPADS
$PADSTACKS
$ENDPADSTACKS
$SHAPES
SHAPE R0402
PIN 1 p_smd -20 0 TOP 0 0
PIN 2 p_smd 20 0 TOP 0 0
$ENDSHAPES
$DEVICES
DEVICE RES_10K
PART RES_10K
TYPE RESISTOR
$ENDDEVICES
$COMPONENTS
COMPONENT R1
DEVICE RES_10K
PLACE 200 250
LAYER TOP
ROTATION 90
SHAPE R0402 0 0
COMPONENT R2
DEVICE RES_10K
PLACE 700 250
LAYER BOTTOM
ROTATION 0
SHAPE R0402 0 0
$ENDCOMPONENTS
$SIGNALS
SIGNAL VCC
NODE R1 1
NODE R2 1
SIGNAL GND
NODE R1 2
NODE R2 2
$ENDSIGNALS
